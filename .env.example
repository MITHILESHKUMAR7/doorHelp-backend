# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/doorhelp

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# OTP (Phase 2 - static/dev mode. Turn OFF before real SMS integration)
OTP_STATIC_MODE=true
OTP_STATIC_CODE=1234

# CORS
CORS_ORIGIN=http://localhost:5173

# Super Admin seed (used by npm run seed:superadmin)
SUPERADMIN_EMAIL=admin@doorhelp.com
SUPERADMIN_PASSWORD=ChangeMe@123
SUPERADMIN_NAME=Super Admin
