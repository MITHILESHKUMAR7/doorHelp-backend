# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/doorhelp

# Auth — USER side (modules/user/auth) — tokens for customers
JWT_USER_ACCESS_SECRET=
JWT_USER_REFRESH_SECRET=
JWT_USER_ACCESS_EXPIRY=15m
JWT_USER_REFRESH_EXPIRY=30d

# Auth — ADMIN side (modules/admin/auth) — tokens for admin/superadmin
# MUST be different from JWT_USER_* above (enforced at boot in config/env.js)
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_ACCESS_EXPIRY=15m
JWT_ADMIN_REFRESH_EXPIRY=7d

# OTP (static/dev mode — set to false and wire SMS provider for production)
OTP_STATIC_MODE=true
OTP_STATIC_CODE=1234

# CORS
CORS_ORIGIN=http://localhost:5173

# Super Admin seed (used by npm run seed:superadmin)
SUPERADMIN_EMAIL=admin@doorhelp.com
SUPERADMIN_PASSWORD=ChangeMe@123
SUPERADMIN_NAME=Super Admin
